AI_PROVIDER=ollama

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# OpenRouter Settings
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_CHAT_MODEL=meta-llama/llama-3-8b-instruct:free

# Gemini Settings
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_CHAT_MODEL=gemini-1.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# MongoDB Settings
MONGO_URI=mongodb://root:rootpassword@localhost:27017
MONGO_DB_NAME=personal_ai_engine

# ZenML Settings
ZENML_STORE_URL=http://localhost:8080


# Notion

NOTION_SECRET_KEY=your_notion_secret_key

NOTION_DATABASE_ID=your_database_id

NOTION_API_VERSION=2022-06-28

NOTION_PAGE_SIZE=100

NOTION_TIMEOUT=15

NOTION_RETRIES=3

NOTION_BACKOFF=2.0



# Crawler

CRAWLER_CONCURRENCY=5

CRAWLER_TIMEOUT=30

CRAWLER_MAX_RESPONSE_SIZE=10485760

CRAWLER_ALLOWED_DOMAINS=[\

example.com\]

CRAWLER_BLOCKED_DOMAINS=[\

ads.example.com\]

CRAWLER_USER_AGENT=PersonalAIEngineBot/1.0



# Quality

QUALITY_SCORE_THRESHOLD=0.5



# MongoDB

MONGO_DB_LOAD_COLLECTION=documents

